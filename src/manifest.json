{
  "name": "No Redirect",
  "description": "A browser extension that intercepts redirect",
  "background": {
    "service_worker": "src/background/index.ts"
  },
  "icons": {
    "16": "img/icon_awesome_face_16.png",
    "32": "img/icon_awesome_face_32.png",
    "48": "img/icon_awesome_face_48.png",
    "128": "img/icon_awesome_face_128.png"
  },
  "options_page": "src/options.html",
  "permissions": ["webNavigation", "storage", "notifications"],
  "manifest_version": 3
}
